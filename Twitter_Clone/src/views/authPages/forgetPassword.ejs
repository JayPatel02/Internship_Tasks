<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/CSS/style.css">
</head>
<body>
    <div class="container">
        <div class="box">
            <h1>Forget Password</h1>

            <div class="input-group">
                <label for="email">Email</label>
                <input type="text" id="email" name="email" placeholder="Email address">
                <span id="userExistMes" class="error-msg" style="display: none;">Enter Valid Email.</span>
            </div>

            <button type="button" id="regBtn" onclick="handleForgetPassword()">Send Reset Link</button>

            <p class="signup-text">
                <a href="/login">Back to Login</a>
            </p>
        </div>
    </div>

    <script src="/JS/validations/validation.js"></script>
    <script src="/JS/authPages/forgetPassword.js"></script>
</body>
</html>