<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/CSS/style.css">
</head>

<body>
    <div class="container">
        <div class="box">
            <p id="timerText">OTP expires in: <span id="timer"></span></p>

            <div class="input-group">
                <label for="pass">New Password</label>
                <input type="password" id="pass" name="pass" placeholder="New password">
                <span id="passError" class="error-msg" style="display: none;">Enter Valid Password.</span>
            </div>

            <div class="input-group">
                <label for="confPass">Confirm Password</label>
                <input type="password" id="confPass" name="confPass" placeholder="Confirm password">
                <span id="matchError" class="error-msg" style="display: none;">Passwords do not match.</span>
            </div>

            <div class="input-group">
                <label for="otp">OTP</label>
                <input type="text" id="otp" name="otp" placeholder="Enter OTP">
            </div>

            <span id="commonError" class="error-msg" style="display: none;"></span>

            <button type="button" id="regBtn" onclick="handleResetPassword()">Reset Password</button>

            <button type="button" id="resendBtn" onclick="handleResendOtp()" disabled>Resend OTP</button>
        </div>
    </div>

    <script src="/JS/validations/validation.js"></script>
    <script>let timeLeft = parseInt(<%= expireTime %>);</script>
    <script src="/JS/authPages/resetPage.js"></script>
</body>

</html>