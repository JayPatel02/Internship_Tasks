<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <div style="display: flex;justify-content: center;margin: 6vmin auto;">
        <fieldset style="width: 30%;">
            <legend>Reset Password</legend>

            <div style="display: flex;flex-direction: column;width: 80%;margin: 2vmin auto;">
                <label for="pass">New Password:</label>
                <small id="spanPass" style="display: none;">Password must be of 8 charcters and must includes one
                    capital letter , one small letter and on special symbol(@,$,!,%,*,?,&).</small>
                <input type="password" id="pass" name="password">
            </div>

            <div style="display: flex;flex-direction: column;width: 80%;margin: 2vmin auto;">
                <label for="confPass">Confirm Password:</label>
                <span id="spanConfPass" style="display: none;color: red;">Does not Match.</span>
                <input type="text" id="confPass">
            </div>

            <div style="display: flex;flex-direction: column;justify-content: center ; margin: 2vmin auto;">
                <span id="errDis" style="display: none;color: red;">Current Password is same as old Password</span>
            </div>


            <div style="display: flex;width: fit-content;margin: 2vmin auto;gap: 4vmin;">
                <button type="button" id="regBtn" onclick="handleResetPass()">Reset Password</button>
            </div>

        </fieldset>
    </div>
    <script src="/JS/validation.js"></script>
    <script>
        window.appData = <%- JSON.stringify(email) %>
    </script>
    <script>
        const errDis = document.getElementById("errDis")
            async function handleResetPass() {
                if (validatePass() && comparePass()) {
                    const res = await fetch("/resetPassword", {
                        method: "post",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            newPassword: currpassword.value,
                            email: appData
                        })
                    })

                    if(res.ok){
                        window.location.href = "/login"
                        errDis.style.display = "none"
                    }else{
                        const response = await res.json()
                        errDis.style.display = "block"
                        errDis.innerText = `${response.message}`
                    }
                }
            }
    </script>
</body>

</html>