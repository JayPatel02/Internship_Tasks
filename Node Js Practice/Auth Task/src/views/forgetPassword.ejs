<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=\, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <div style="display: flex;justify-content: center;margin: 5vmin auto;">
        <fieldset>
            <legend>Forget Password</legend>
            <div style="padding: 3vmin;display: flex;flex-direction: column;">
                <div style="display: flex;flex-direction: column;margin: 2vmin auto;">
                    <label for="email">Email:</label>
                    <span id="spanEM" style="display: none;">Invalid Email / Already Exist.</span>
                    <input type="text" id="email" name="email">
                </div>

                <div style="display: flex;flex-direction: column;">
                    <small id="userExistMes" style="display: none;color: red;">Email Does Not Exist.</small>
                </div>

                <button type="button" id="submitBtn" onclick="handleSubmit()">Generate Link</button>
            </div>
        </fieldset>
    </div>
    <script src="/JS/validation.js"></script>
    <script>
        async function handleSubmit(){
            const isLocalValid = valEmail();
            const isServerValid = await checkEmail();
    
            if (isLocalValid && isServerValid === false) {
                document.getElementById("userExistMes").style.display = "none";
    
                // form.submit();
                const res = await fetch("/forgetPassword",{
                    method: "post",
                    headers: {
                        "Content-Type" : "application/json"
                    }
                })
                const result = await res.json()
                const link = result.link + `?email=${email.value}`
                window.location.href = link
    
            } else if (isLocalValid && isServerValid === true) {
                // This means local check passed, but email wasn't found in DB
                document.getElementById("userExistMes").style.display = "block";
            }
        }
    </script>
</body>

</html>