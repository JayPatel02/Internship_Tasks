<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <table style="width: 50%;text-align: center;">
        <thead>
            <th>Id</th>
            <th>User Name</th>
            <th>File Name</th>
            <th>Time</th>
            <th>Update</th>
            <th>Delete</th>
        </thead>
        <% data.forEach( (row,i) => { %>
            <% if(i > 0){  %>  
            <% row = row.split(",") %>
                <tr>
                    <td><%= row[0] %></td>
                    <td><%= row[1] %></td>
                    <td><%= row[2] %></td>
                    <% let disDate = new Date(row[3]).toLocaleString("en-US",{timeZone : "America/New_York"})  %>
                    <td><%= disDate %></td>
                    <td><button type="button" onclick="handleUpdate(<%= row[0] %>)" >Update</button></td>
                    <td><button type="button" onclick="handleDelete(<%= row[0] %>)" >Delete</button></td>
                </tr>
            <% } %>
        <% }); %>
    </table>
</body>

    <script>
        function handleDelete(id){
            window.location.href = `/delete/${id}`
        }
        function handleUpdate(id){
            window.location.href = `/update/${id}`
        }
    </script>

</html>