<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/updateRecord/<%= data[0] %>" method="post" enctype="multipart/form-data">
        <input type="text" name="userName" value=<%= data ? data[1] : "" %> >
        <input type="file" name="profilePic" accept="image/png, image/jpeg"> 
        <br><br>
        <input type="submit" value=<%= data ? "Save" : "Submit" %>>
        <input type="reset" value="Reset">
    </form>    
</body>
</html>